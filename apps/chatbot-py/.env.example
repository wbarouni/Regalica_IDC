# PostgreSQL DSN — required for the /chat/* routes (asyncpg pool
# pre-warmed at startup) and the /upload pipeline (workflow_steps +
# prompt_bank reads).
DATABASE_URL=

# REGFlow Node API base URL — used by chatbot-py for service-to-
# service writes (engine fail-details, message persistence). The
# JWT_SECRET below signs the Bearer token validated by the API's
# engineAuthMiddleware (apps/api/src/middleware/engineAuth.ts).
REGFLOW_API_URL=http://localhost:3000
JWT_SECRET=

# HTTP boundary
CHATBOT_PY_PORT=8000
NODE_ENV=development
LOG_LEVEL=info

# CORS allow-list (comma-separated origins). Empty -> no
# cross-origin (same-origin still works).
CHATBOT_CORS_ORIGIN=http://localhost:5173

# LLM provider — the Literal types in app/config.py only accept the
# values listed here (gemini | ollama). No silent fallback if a
# value is missing — the process fails at startup.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=8192
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# Phase 3 router target — the (agent_type, function_name) pair the
# orchestrator looks up in prompt_bank to drive intent detection.
# Operator-controlled so no agent key is baked into source.
CHATBOT_ROUTER_AGENT_TYPE=regalica
CHATBOT_ROUTER_FUNCTION_NAME=router

# Commit 41c briefing target — loaded by /upload after the T0
# deterministic agents have run, to compose the user-facing
# confirmation message. Same env-driven pattern as the router
# target (Guard D-004 keeps the (agent_type, function_name) tuple
# out of source code).
CHATBOT_BRIEFING_AGENT_TYPE=regalica
CHATBOT_BRIEFING_FUNCTION_NAME=xml_received
