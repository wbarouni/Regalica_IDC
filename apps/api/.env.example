# =============================================================================
# REGFlow API (apps/api) — example environment variables
# Copy to apps/api/.env for local dev or set the equivalent values in your
# CI/Docker environment. NEVER commit real secrets.
# =============================================================================
#
# This file is consumed by `apps/api/src/config.ts` (Zod-validated at module
# load). Every entry below is REQUIRED unless explicitly marked optional.
# Missing values fail process startup with a clear error — there is no
# silent fallback.
#
# The root .env.example carries the same vars (plus those consumed by
# chatbot-py and the web frontend). When working from Docker Compose, the
# root .env is the single source of truth and this file is informational.
# When running `pnpm --filter @regflow/api dev` outside compose, copy this
# file to apps/api/.env.

# ---- Node runtime ----------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- API HTTP boundary -----------------------------------------------------
API_PORT=3000
# Frontend origin (Vite dev server) — exact match required by the CORS
# middleware. Comma-separated lists not supported by the canonical config.
API_CORS_ORIGIN=http://localhost:5173

# ---- PostgreSQL ------------------------------------------------------------
# Resolves to the Docker `postgres` service when the API runs inside the
# compose stack. Override to `localhost:5432` (or the host you binded) when
# running the API on the metal.
DATABASE_URL=postgresql://regalica_app:change_me_in_local_env@postgres:5432/regalica
# Connection pool tuning (no defaults baked into source).
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONN_TIMEOUT_MS=5000

# ---- JWT signing / verification --------------------------------------------
# REQUIRED. Identical value MUST be set in the chatbot-py .env so the
# engine middleware accepts the bearer signed by chatbot-py. Generate a
# fresh value with: openssl rand -base64 48
JWT_SECRET=change_me_generate_with_openssl_rand_base64_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Engine JWT contract ---------------------------------------------------
# Role claim string the API verifies on every engine token. chatbot-py
# signs with the same value. MUST match byte-for-byte.
REGFLOW_ENGINE_ROLE_CLAIM=regflow_engine

# ---- Inter-service URL (optional in tests, required in dev/prod) -----------
# Base URL of the chatbot-py FastAPI service. Posted to by the API's
# kickoffEngineAsync (apps/api/src/routes/runs.ts) to start the T0 pipeline.
# Empty/unset disables the kickoff (tests, smoke jobs).
CHATBOT_PY_URL=http://chatbot-py:8000
