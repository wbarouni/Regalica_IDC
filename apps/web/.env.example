# API Express backend (apps/api). Required at runtime; the frontend
# refuses to call any route until this is set, by design (no silent
# fallback, see apps/web/src/lib/config.ts).
VITE_API_URL=

# Python chatbot backend (apps/chatbot-py).
VITE_CHATBOT_URL=

# UUID of the current tenant. Required at runtime for every
# /api/tenants/:tenantId/* call.
VITE_TENANT_ID=

# UUID of the current user. Sent as X-User-Id on every API call.
VITE_USER_ID=

# Display name of the tenant in the UI (e.g. header).
VITE_TENANT_DISPLAY_NAME=

# Default page size for paginated lists (rules, fails, notifications, …).
VITE_DEFAULT_PAGE_SIZE=50

# Brand identity displayed in the persona sidebar.
VITE_BRAND_NAME=
VITE_PRODUCT_NAME=

# UI display constants (truncation lengths). Both values are integers.
VITE_RUN_ID_DISPLAY_LENGTH=8
VITE_RULE_LABEL_PREVIEW_LENGTH=60

# SSE reconnect base (ms). The hook doubles this on each retry up to
# 4x the base. Lower it in development to fail fast against a flaky
# local backend; raise it in production to be gentle on the API.
VITE_SSE_RECONNECT_BASE_MS=1000

# Vite 5.4 host-header allow-list (CVE-2025-30208). Unset for stock
# behaviour (localhost only). Comma-separated list whitelists a reverse
# proxy or preview tunnel. The literal 'all' disables the check entirely
# (dev convenience; never set in production builds).
VITE_ALLOWED_HOSTS=
