# =============================================================================
# Regalica IDC — example environment variables
# Copy to .env for local dev. NEVER commit real secrets.
# =============================================================================

# ---- Node environment ------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL (shared by api + chatbot-py) -------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=regalica
POSTGRES_USER=regalica_app
POSTGRES_PASSWORD=change_me_in_local_env
DATABASE_URL=postgresql://regalica_app:change_me_in_local_env@postgres:5432/regalica

# ---- API (Express + pg native) ---------------------------------------------
API_PORT=3000
API_CORS_ORIGIN=http://localhost:4200
JWT_SECRET=change_me_generate_with_openssl_rand_base64_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Engine JWT role claim (required, no default). The Node API
# verifies the `role` claim of every incoming engine token verbatim
# against this value; chatbot-py signs every outgoing engine token
# with the same value. Must match between the two apps.
REGFLOW_ENGINE_ROLE_CLAIM=regflow_engine

# ---- API pg connection pool (no defaults baked into source) ----------------
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONN_TIMEOUT_MS=5000

# ---- Chatbot Python (FastAPI + LLM) ----------------------------------------
# All LLM_*, GEMINI_*, OLLAMA_*, EMBEDDING_* variables below are REQUIRED by
# apps/chatbot-py (Pydantic Settings raises at startup if any is missing).
# No silent defaults live in app/config.py; the operator owns the model
# versions by setting them here.
CHATBOT_PY_PORT=8000
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=8192
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
# Phase 3 Regalica router target — the prompt_bank entry the
# orchestrator queries to detect the user intent. Phase 3-bis
# replaces this pair with a planner pipeline (doc 10 §15-16).
CHATBOT_ROUTER_AGENT_TYPE=regalica
CHATBOT_ROUTER_FUNCTION_NAME=router
# Phase 3-bis Regalica planner target — the prompt_bank entry
# invoked conditionally after the router for intents listed in
# platform_config.regalica_planner_trigger_intents (migration 068).
CHATBOT_PLANNER_AGENT_TYPE=regalica
CHATBOT_PLANNER_FUNCTION_NAME=planner
# T0 briefing prompt target loaded by /upload after the deterministic
# T0 agents have run. Same env-driven pattern as the router target so
# no (agent_type, function_name) literal sits in source (Guard D-004).
# Required at chatbot-py startup; missing values fail Settings validation.
CHATBOT_BRIEFING_AGENT_TYPE=regalica
CHATBOT_BRIEFING_FUNCTION_NAME=xml_received
# T1 synthesis aggregator target invoked by /upload at the end of the
# auto-chained T1 pipeline (Tranche 1.2). The bearer mirrors the chat
# path's regalica/aggregate_t1_result (seeded by 072-C / promoted by
# 072-B). Env-driven so no agent literal sits in source.
CHATBOT_T1_AGGREGATOR_AGENT_TYPE=regalica
CHATBOT_T1_AGGREGATOR_FUNCTION_NAME=aggregate_t1_result
# Base URL of the REGFlow Node API used by chatbot-py for service-to-
# service calls (engine fail-details, agent-step events, /finalize).
# Required at chatbot-py startup. When chatbot-py runs in Docker and
# the API runs on the host, use http://host.docker.internal:3000.
REGFLOW_API_URL=http://api:3000
# Comma-separated list of origins allowed to call /chat/*.
# Must include the frontend (apps/web at VITE_CHATBOT_URL).
CHATBOT_CORS_ORIGIN=http://localhost:5173

# ---- Nginx reverse proxy ---------------------------------------------------
NGINX_PORT=80

# ---- Observability ---------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
