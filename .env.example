# =============================================================================
# Regalica IDC — example environment variables
# Copy to .env for local dev. NEVER commit real secrets.
# =============================================================================

# ---- Node environment ------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL (shared by api + chatbot-node + chatbot-py) ----------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=regalica
POSTGRES_USER=regalica_app
POSTGRES_PASSWORD=change_me_in_local_env
DATABASE_URL=postgresql://regalica_app:change_me_in_local_env@postgres:5432/regalica

# ---- API (Express + Sequelize) ---------------------------------------------
API_PORT=3000
API_CORS_ORIGIN=http://localhost:4200
JWT_SECRET=change_me_generate_with_openssl_rand_base64_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Chatbot Node (Express + pg natif) -------------------------------------
CHATBOT_NODE_PORT=3001
CHATBOT_PY_URL=http://chatbot-py:8000

# ---- Chatbot Python (FastAPI + LLM) ----------------------------------------
CHATBOT_PY_PORT=8000
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# ---- Frontend (Angular 18) -------------------------------------------------
FRONTEND_PORT=4200

# ---- Azure Blob Storage ----------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=regalica-uploads

# ---- Nginx reverse proxy ---------------------------------------------------
NGINX_PORT=80

# ---- Observability ---------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
