# =============================================================================
# Regalica IDC — example environment variables
# Copy to .env for local dev. NEVER commit real secrets.
# =============================================================================

# ---- Node environment ------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL (shared by api + chatbot-py) -------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=regalica
POSTGRES_USER=regalica_app
POSTGRES_PASSWORD=change_me_in_local_env
DATABASE_URL=postgresql://regalica_app:change_me_in_local_env@postgres:5432/regalica

# ---- API (Express + pg native) ---------------------------------------------
API_PORT=3000
API_CORS_ORIGIN=http://localhost:4200
JWT_SECRET=change_me_generate_with_openssl_rand_base64_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- API pg connection pool (no defaults baked into source) ----------------
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONN_TIMEOUT_MS=5000

# ---- Chatbot Python (FastAPI + LLM) ----------------------------------------
# All LLM_*, GEMINI_*, OLLAMA_*, EMBEDDING_* variables below are REQUIRED by
# apps/chatbot-py (Pydantic Settings raises at startup if any is missing).
# No silent defaults live in app/config.py; the operator owns the model
# versions by setting them here.
CHATBOT_PY_PORT=8000
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=8192
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
# Phase 3 Regalica router target — the prompt_bank entry the
# orchestrator queries to detect the user intent. Phase 3-bis
# replaces this pair with a planner pipeline (doc 10 §15-16).
CHATBOT_ROUTER_AGENT_TYPE=regalica
CHATBOT_ROUTER_FUNCTION_NAME=router
# Comma-separated list of origins allowed to call /chat/*.
# Must include the frontend (apps/web at VITE_CHATBOT_URL).
CHATBOT_CORS_ORIGIN=http://localhost:5173

# ---- Nginx reverse proxy ---------------------------------------------------
NGINX_PORT=80

# ---- Observability ---------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
