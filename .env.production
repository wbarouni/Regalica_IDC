# ============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================================================

# Base de données
DATABASE_URL="mysql://user:password@host:3306/regalica_prod"

# Authentification
JWT_SECRET="your-production-jwt-secret-min-32-characters-long"
JWT_EXPIRATION="7d"
BCRYPT_ROUNDS="10"

# Gemini API
GEMINI_API_KEY="your-production-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash-lite"

# Application
NODE_ENV="production"
NEXT_PUBLIC_API_URL="https://regalica-idc.vercel.app"
NEXT_PUBLIC_APP_NAME="Regalica IDC"
NEXT_PUBLIC_APP_VERSION="1.0.0"
API_PORT="3000"

# Fichiers et uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="52428800"
ALLOWED_FILE_TYPES="xml,xlsx,csv"

# Logging
LOG_LEVEL="info"
ENABLE_AUDIT_LOGS="true"
AUDIT_RETENTION_DAYS="90"

# Validation RDG
RDG_RULES_FILE="./public/rdg_rules.json"
RDG_TOLERANCE="0.01"
RDG_ENABLE_SMART_VALIDATION="true"

# CORS et sécurité
CORS_ORIGIN="https://regalica-idc.vercel.app"
ENABLE_RATE_LIMITING="true"
RATE_LIMIT_WINDOW="15m"
RATE_LIMIT_MAX_REQUESTS="100"
