{
  "name": "Regalica IDC",
  "version": 2,
  "public": false,
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "nodeVersion": "18.x",
  "env": [
    {
      "key": "DATABASE_URL",
      "description": "URL de connexion à la base de données MySQL",
      "value": "",
      "type": "secret"
    },
    {
      "key": "JWT_SECRET",
      "description": "Clé secrète pour les tokens JWT (min 32 caractères)",
      "value": "",
      "type": "secret"
    },
    {
      "key": "GEMINI_API_KEY",
      "description": "Clé API Google Gemini pour la validation intelligente",
      "value": "",
      "type": "secret"
    },
    {
      "key": "NODE_ENV",
      "description": "Environnement d'exécution",
      "value": "production"
    },
    {
      "key": "NEXT_PUBLIC_API_URL",
      "description": "URL de l'API en production",
      "value": "https://regalica-idc.vercel.app"
    }
  ],
  "regions": ["cdg1", "iad1"],
  "functions": {
    "api/**": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/dashboard",
      "permanent": false
    }
  ]
}
