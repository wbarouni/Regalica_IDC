# Root .dockerignore — applies to Docker builds with context=.
# Keeps build contexts small and secrets out of images.

**/node_modules
**/dist
**/build
**/.angular
**/coverage
**/.nyc_output
**/playwright-report
**/test-results

**/__pycache__
**/*.py[cod]
**/.venv
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage
**/uv.lock

**/.git
**/.github
.gitignore
.gitattributes

**/.vscode
**/.idea
**/*.swp

# Secrets
**/.env
**/.env.*
!**/.env.example

# Local state
*.log
*.pid
tmp/

# Heavy fixtures — not needed in service images
tests/fixtures
tests/e2e

# Docs — baked into service images? No.
docs
*.md
!README.md
!apps/*/README.md
!packages/*/README.md

# Infra
infra/gcp
