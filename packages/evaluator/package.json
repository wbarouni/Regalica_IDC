{
  "name": "@regflow/evaluator",
  "version": "1.0.0",
  "private": true,
  "description": "Moteur d'évaluation RDG canonique en 5 phases (A/B/D/E) avec test golden",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:golden": "jest --testPathPattern=golden",
    "test:golden:capture": "REGFLOW_GOLDEN_MODE=capture jest --testPathPattern=golden",
    "lint": "echo \"(evaluator) lint wired in Phase 1 when root @eslint/js is hoisted\" && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@regflow/bct-xml-parser": "workspace:*",
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
