{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "--port", "3000"],
      "port": 3000,
      "cwd": "apps/web"
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ng", "serve", "--port", "4200", "--host", "0.0.0.0", "--proxy-config", "proxy.conf.json"],
      "port": 4200,
      "cwd": "apps/frontend"
    }
  ]
}
